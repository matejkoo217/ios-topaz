fuxi: 0108 -- answer kAKSWrapKey/kAKSUnwrapKey, and stop the AKS trace flooding the boot

The live console now reaches the host, and what it shows is CommCenter in a crash
loop: "CRASH CommCenter reason ns 2 code 0x6", "exec CommCenter", report, repeat,
eight times in ten seconds.  The line that explains it is

  FUXI AKS: securityd sel 10 arg0 0 in 2/32 out 1/40 -> 0xe00002c7

sel 10 is kAKSWrapKey (kIOReturnUnsupported is iokit_common_err(0x2c7)), so
securityd asks for CommCenter's identity key to be wrapped and the stub's default
arm refuses.  With no passcode and no class key there is nothing to wrap with, so
wrap becomes the identity and unwrap does the same: each is the other's inverse,
which keeps the caller's round trip self-consistent.  If a caller parses the blob
as a real AKS container it will fail later, and that shows up as the next failure
in the log rather than as silence.

Second half: one IOLog per AKS selector call is enough to dominate a boot, because
each line goes to a framebuffer that is Device memory with the MMU off, and it
also floods the netlog.  Tracing is now behind sweetakstrace=1; failures always
print, since those are the ones that explain a crash loop.

Harness: applied=107 skipped=0.
--- a/iokit/Kernel/arm/FuxiKeyStore.cpp
+++ b/iokit/Kernel/arm/FuxiKeyStore.cpp
@@ -15,6 +15,7 @@
  * with kIOReturnUnsupported.
  */
 #include <pexpert/arm64/board_config.h>
+#include <pexpert/pexpert.h>
 
 #if defined(ARM64_BOARD_CONFIG_FUXI)
 #include <IOKit/IOService.h>
@@ -57,6 +58,8 @@
  * aks lock state bits (aks_get_lock_state): bit 2 is "unlocked since boot"
  * (MobileKeyBag MKBDeviceUnlockedSinceBoot); clear lock bits = unlocked.
  */
+static int fuxi_aks_trace;
+
 #define FUXI_AKS_LOCK_STATE    0x4
 
 class AppleKeyStore : public IOService {
@@ -76,6 +79,7 @@
 	}
 	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
 	registerService();
+	PE_parse_boot_argn("sweetakstrace", &fuxi_aks_trace, sizeof(fuxi_aks_trace));
 	IOLog("FUXI AKS: AppleKeyStore registered (no passcode, unlocked)\n");
 	return true;
 }
@@ -222,6 +226,38 @@
 		args->scalarOutput[0] = 0;
 		args->scalarOutputCount = 1;
 		break;
+	/*
+	 * kAKSWrapKey / kAKSUnwrapKey: CommCenter asks for its identity key to be
+	 * wrapped before it will start, and it is the first client to crash when this
+	 * returns kIOReturnUnsupported.  With no class key and no passcode there is
+	 * nothing to wrap with, so the wrap is the identity and the unwrap is too:
+	 * they are each other's inverse, which keeps the caller's round trip
+	 * self-consistent.  A caller that parses the blob as a real AKS container will
+	 * still complain, and that will show up in the log as the next failure.
+	 */
+	case kAKSWrapKey:
+	case kAKSUnwrapKey: {
+		uint8_t buf[512];
+		uint32_t len = args->structureInputDescriptor != NULL ?
+		    (uint32_t)args->structureInputDescriptor->getLength() :
+		    args->structureInputSize;
+		const void *in = args->structureInput;
+
+		if (len == 0) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		len = MIN(len, (uint32_t)sizeof(buf));
+		if (args->structureInputDescriptor != NULL) {
+			args->structureInputDescriptor->readBytes(0, buf, len);
+			in = buf;
+		} else if (in == NULL) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		ret = fuxi_aks_struct_out(args, in, len);
+		break;
+	}
 	case kAKSGetDeviceState:
 	case kAKSGetExtDeviceState:
 		args->scalarOutputCount = 0;
@@ -232,10 +268,18 @@
 		break;
 	}
 
-	char name[32];
-	proc_selfname(name, sizeof(name));
-	IOLog("FUXI AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
-	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	/*
+	 * Per-call tracing is the only way to see what a daemon wanted from AKS, but
+	 * one line per selector call on a Device-memory framebuffer is enough to
+	 * dominate a boot, so it is behind sweetakstrace=1.  Failures always print:
+	 * those are the ones that explain a crash loop.
+	 */
+	if (ret != kIOReturnSuccess || fuxi_aks_trace) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("FUXI AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name,
+		    selector, arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	}
 	return ret;
 }
 #endif /* ARM64_BOARD_CONFIG_FUXI */
