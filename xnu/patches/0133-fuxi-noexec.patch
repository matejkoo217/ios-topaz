fuxi: 0133 -- fuxinoexec: stub named binaries instead of letting them crash-loop

CommCenter aborts in a loop (SIGABRT code 0x6, SIGSEGV sig 11 code 0x100000001, code 0xb)
and fairplayd.H2 and bluetoothd cycle with it, exactly where the boot sits at 17%.  This
port has no baseband and no SEP, so those daemons have nothing to talk to.

fuxinoexec=name[,name...] makes the exec complete and then stops the process.  A refused
exec sends launchd into a retry loop; a stopped process looks alive to launchd, never
crashes, never respawns and uses no CPU, so the boot stops paying for it.  The signal lands
on the return to user mode, after the exec finishes.

Off unless the boot arg is given.

Harness: applied=131 skipped=0.
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7325,6 +7325,36 @@
 	return error;
 }
 
+/*
+ * Match a program name against a comma-separated deny list.
+ *
+ * Plain pointer arithmetic on purpose: libkern.h here does not declare strstr, and an
+ * implicit declaration is a hard error under this build's flags.
+ */
+static int
+fuxi_exec_denied(const char *name, const char *list)
+{
+	const char *p = list;
+
+	while (*p != '\0') {
+		const char *n = name;
+		const char *q = p;
+
+		while (*q != '\0' && *q != ',' && *q == *n) {
+			q++;
+			n++;
+		}
+		if ((*q == '\0' || *q == ',') && *n == '\0') {
+			return 1;
+		}
+		while (*q != '\0' && *q != ',') {
+			q++;
+		}
+		p = (*q == ',') ? q + 1 : q;
+	}
+	return 0;
+}
+
 static int
 process_signature(proc_t p, struct image_params *imgp)
 {
@@ -7412,6 +7442,29 @@
 				goto done;
 			}
 #if defined(ARM64_BOARD_CONFIG_FUXI)
+			/*
+			 * fuxinoexec=name[,name...] refuses the named binaries.
+			 *
+			 * Diagnostic, not a fix: telephony and DRM daemons abort in a loop on
+			 * this port (no baseband, no SEP), and the question is whether their
+			 * respawn loop is what holds the boot at 17%.  Refusing the exec makes
+			 * launchd give up on them instead of restarting them forever.
+			 */
+			{
+				char deny[160] = "";
+
+				if (PE_parse_boot_argn("fuxinoexec", deny, sizeof(deny)) &&
+				    deny[0] != '\0' && fuxi_exec_denied(p->p_name, deny)) {
+					/*
+					 * Stub, do not refuse: a refused exec sends launchd into a
+					 * retry loop, while a stopped process looks alive, never
+					 * crashes, never respawns and uses no CPU.  The signal lands
+					 * on the return to user mode, after the exec itself completes.
+					 */
+					printf("exec %s stubbed (stopped)\n", p->p_name);
+					psignal(p, SIGSTOP);
+				}
+			}
 			/* SWEET runs every iOS binary this way: one short line per exec. */
 			printf("exec %s\n", p->p_name);
 #else
