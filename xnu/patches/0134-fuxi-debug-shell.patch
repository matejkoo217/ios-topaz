+/*
+ * The shell replies are bigger than one datagram (a ps of 150 processes, a 4 KiB
+ * file), so they go out in pieces; every reply ends with the shell's end marker
+ * and the host reads until it sees it.
+ */
+#define FUXI_CMD_CHUNK  1024u
+
+static void
+ud_cmd_reply_all(socket_t so, const char *buf, size_t len)
+{
+	size_t off = 0;
+
+	while (off < len) {
+		size_t n = len - off;
+
+		if (n > FUXI_CMD_CHUNK) {
+			n = FUXI_CMD_CHUNK;
+		}
+		ud_cmd_send_raw(so, buf + off, n);
+		off += n;
+	}
+}
