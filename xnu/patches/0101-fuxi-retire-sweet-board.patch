 #endif  /* ARM64_BOARD_CONFIG_BCM2837 */
 
-#if defined(ARM64_BOARD_CONFIG_FUXI) && !defined(ARM64_BOARD_CONFIG_FUXI)
-#include <pexpert/arm64/SWEET.h>
-
-#define MAX_L2_CLINE                   6
-#define MAX_CPUS                       8
-#define MAX_CPU_CLUSTERS               1
-
-#define CORE_NCTRS                     8 /* Placeholder; KPC is not enabled for this target */
-
-#endif  /* ARM64_BOARD_CONFIG_FUXI */
-
 #ifdef ARM64_BOARD_CONFIG_FUXI
 #include <pexpert/arm64/FUXI.h>
 
diff --git a/pexpert/pexpert/arm64/FUXI.h b/pexpert/pexpert/arm64/FUXI.h
--- a/pexpert/pexpert/arm64/FUXI.h
+++ b/pexpert/pexpert/arm64/FUXI.h
@@ -30,26 +30,21 @@
 
 /*
  * fuxi inherits the sweet (SM7150) bring-up: the Qualcomm driver stack added
- * by the 0003-0093 patch series (fuxi_ufs, AppleKeyStore, IOSurface/IOMFB,
- * IOWatchdog, FuxiPlatformExpert/CPU, AMFI, ...) is gated on the sweet board
- * macros. Keep both defined so those drivers build into the FUXI kernel.
+ * by the 0003-0099 patch series (fuxi_ufs, AppleKeyStore, IOSurface/IOMFB,
+ * IOWatchdog, FuxiPlatformExpert/CPU, AMFI, ...) is gated on
+ * ARM64_BOARD_CONFIG_FUXI, the same macro this board is built with. The
+ * SM7150 reference configuration and its board header were retired with the
+ * rename, so there is no second board macro to keep in step any more.
  *
- *   FUXI  - the SM8550 board; new/retargeted code should gate on this.
- *   SWEET - the inherited bring-up family (kept for the existing drivers).
- *           MACHINE_FLAGS_ARM64_FUXI also passes -DARM64_BOARD_CONFIG_FUXI.
- *
- * TODO fuxi: split the SoC-independent bring-up out of the SWEET guards, then
+ * TODO fuxi: split the SoC-independent bring-up out of the FUXI guards, then
  * gate the SM7150-specific bits (SPMI/GENI SE7/GT9896 addresses, RPMh, the
- * gauge, ...) on `SWEET && !FUXI` and the SM8550 bits on FUXI. Until then,
- * code under `#if defined(ARM64_BOARD_CONFIG_FUXI)` (e.g. patch 0081's userland LSE emulation)
- * also compiles into the FUXI kernel; see MACHINE_CONFIG_FUXI.md.
+ * gauge, ...) on something narrower and the SM8550 bits separately. Until
+ * then, code such as patch 0081's userland LSE emulation also compiles into
+ * the FUXI kernel; see MACHINE_CONFIG_FUXI.md.
  */
 #define FUXI                      1
-#define SWEET                     1
-/* sweet's board_config.h is NOT included for FUXI (see the
- * `&& !defined(ARM64_BOARD_CONFIG_FUXI)` guard), so the shared SWEET bridge
- * needs this one here: iokit/Kernel/arm/FuxiCPU.cpp and
- * osfmk/arm64/machine_routines.c both use it. Same value as SWEET.h. */
+/* iokit/Kernel/arm/FuxiCPU.cpp and osfmk/arm64/machine_routines.c both use
+ * this; SM8550 has 8 cores. */
 #define FUXI_SMP_MAX_CPUS         8
 
 #define ARM_ARCH_TIMER
