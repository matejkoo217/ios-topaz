+/*
+ * Framebuffer capture: the eyes on this port.
+ *
+ * A boot that stopped at the progress bar and one that finished look identical
+ * when the only report is a photo.  The console already owns the panel
+ * (pe_serial.c probes the "sweet-fbcon" node), so the kernel reads it and sends a
+ * decimated frame over the same link as the log:
+ *
+ *   "FUXIFB1\0" | frame u32 | chunk u32 | chunks u32 |
+ *   width u32 | height u32 | scale u32 | payload u32 | RGB triplets
+ *   to 192.168.7.1:5142
+ *
+ * It runs in a persistent kernel thread that sleeps on a channel between grabs.
+ * The first version grabbed inside the ethertype receive handler: the phone
+ * stopped answering mid-frame and never came back.  A separate thread cannot wedge
+ * the receive path; the send is bounded by FUXI_FB_CHUNK_MAX and by five
+ * consecutive failures; and the thread outlives a grab instead of exiting (a
+ * one-shot thread would need thread_terminate, which bsd/dev cannot see).
+ */
+#define FUXI_FB_PORT    5142u
+#define FUXI_FB_MAGIC   "FUXIFB1"
+#define FUXI_FB_CHUNK   1368            /* payload bytes per datagram */
+#define FUXI_FB_SCALE   4u              /* decimation; 'fb [scale]' overrides */
+#define FUXI_FB_CHUNK_MAX 4096u         /* ceiling: ~5.5 MB of RGB */
+
+extern bool fuxi_fbcon_info(uint64_t *pa, uint64_t *len, uint32_t *w, uint32_t *h,
+    uint32_t *stride);
+
+struct fuxi_fb_hdr {
+	char     magic[8];
+	uint32_t frame;
+	uint32_t chunk;
+	uint32_t chunks;
+	uint32_t width;
+	uint32_t height;
+	uint32_t scale;
+	uint32_t payload;
+};
+
+static volatile uint32_t *fuxi_fb_base;
+static uint32_t fuxi_fb_w, fuxi_fb_h, fuxi_fb_stride;
+static uint32_t fuxi_fb_frame;
+static uint32_t fuxi_fb_request;
+static int fuxi_fb_chan;
+static uint8_t fuxi_fb_pkt[sizeof(struct fuxi_fb_hdr) + FUXI_FB_CHUNK];
+
+static bool
+fuxi_fb_map(void)
+{
+	uint64_t pa = 0, len = 0;
+
+	if (fuxi_fb_base != NULL) {
+		return true;
+	}
+	if (!fuxi_fbcon_info(&pa, &len, &fuxi_fb_w, &fuxi_fb_h, &fuxi_fb_stride) ||
+	    fuxi_fb_w == 0 || fuxi_fb_h == 0) {
+		printf("FUXI FB: no framebuffer (sweet-fbcon not probed)\n");
+		return false;
+	}
+	fuxi_fb_base = (volatile uint32_t *)ml_io_map((vm_offset_t)pa, (vm_size_t)len);
+	if (fuxi_fb_base == NULL) {
+		printf("FUXI FB: map failed for 0x%llx\n", pa);
+		return false;
+	}
+	printf("FUXI FB: %ux%u stride %u at 0x%llx\n", fuxi_fb_w, fuxi_fb_h,
+	    fuxi_fb_stride, pa);
+	return true;
+}
+
+/* One datagram: header plus the pixels collected so far. */
+static void
+fuxi_fb_flush(socket_t so, struct fuxi_fb_hdr *h, uint32_t used, uint32_t index,
+    uint32_t *errors)
+{
+	struct sockaddr_in to;
+	struct iovec iov;
+	struct msghdr msg;
+	size_t sent = 0;
+
+	h->chunk = index;
+	h->payload = used;
+	memcpy(fuxi_fb_pkt, h, sizeof(*h));
+
+	bzero(&to, sizeof(to));
+	to.sin_len = sizeof(to);
+	to.sin_family = AF_INET;
+	to.sin_port = htons(FUXI_FB_PORT);
+	to.sin_addr.s_addr = htonl(FUXI_CMD_PEER);
+
+	iov.iov_base = fuxi_fb_pkt;
+	iov.iov_len = sizeof(*h) + used;
+	bzero(&msg, sizeof(msg));
+	msg.msg_name = &to;
+	msg.msg_namelen = (socklen_t)sizeof(to);
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+	if (sock_send(so, &msg, 0, &sent) != 0) {
+		(*errors)++;
+	}
+}
+
+static void
+fuxi_fb_grab(uint32_t scale)
+{
+	struct fuxi_fb_hdr h;
+	uint8_t *payload = fuxi_fb_pkt + sizeof(h);
+	socket_t so = NULL;
+	uint32_t ow, oh, chunks, chunk = 0, used = 0, errors = 0;
+
+	if (!fuxi_fb_map()) {
+		return;
+	}
+	if (scale == 0) {
+		scale = FUXI_FB_SCALE;
+	}
+	ow = fuxi_fb_w / scale;
+	oh = fuxi_fb_h / scale;
+	if (ow == 0 || oh == 0) {
+		return;
+	}
+	chunks = (ow * oh * 3u + FUXI_FB_CHUNK - 1) / FUXI_FB_CHUNK;
+	if (chunks > FUXI_FB_CHUNK_MAX) {
+		printf("FUXI FB: %u chunks exceeds the ceiling; not sending\n", chunks);
+		return;
+	}
+	if (sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so) != 0) {
+		printf("FUXI FB: socket failed\n");
+		return;
+	}
+
+	bzero(&h, sizeof(h));
+	memcpy(h.magic, FUXI_FB_MAGIC, 8);
+	h.frame = ++fuxi_fb_frame;
+	h.chunks = chunks;
+	h.width = ow;
+	h.height = oh;
+	h.scale = scale;
+
+	for (uint32_t y = 0; y < oh; y++) {
+		volatile uint32_t *row = fuxi_fb_base +
+		    (uint64_t)(y * scale) * (fuxi_fb_stride / 4);
+
+		for (uint32_t x = 0; x < ow; x++) {
+			uint32_t px = row[x * scale];
+
+			if (used + 3 > FUXI_FB_CHUNK) {
+				fuxi_fb_flush(so, &h, used, chunk++, &errors);
+				used = 0;
+				if (errors > 5) {
+					printf("FUXI FB: sends failing, aborting\n");
+					goto done;
+				}
+				if ((chunk & 63u) == 0) {
+					ud_sleep_ms(1);   /* let the TX queue drain */
+				}
+			}
+			payload[used++] = (uint8_t)(px >> 16);   /* R */
+			payload[used++] = (uint8_t)(px >> 8);    /* G */
+			payload[used++] = (uint8_t)(px);         /* B */
+		}
+	}
+	if (used > 0) {
+		fuxi_fb_flush(so, &h, used, chunk++, &errors);
+	}
+done:
+	sock_close(so);
+	printf("FUXI FB: frame %u %ux%u scale %u, %u chunks, %u errors\n",
+	    h.frame, ow, oh, scale, chunk, errors);
+}
+
+static void
+fuxi_fb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		(void)tsleep(&fuxi_fb_chan, PZERO, "fuxifb", 0);
+		if (fuxi_fb_request != 0) {
+			uint32_t scale = fuxi_fb_request;
+			fuxi_fb_request = 0;
+			fuxi_fb_grab(scale);
+		}
+	}
+}
+
+static void
+fuxi_fb_start_thread(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(fuxi_fb_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+static int
+fuxi_fb_kick(uint32_t scale)
+{
+	if (!fuxi_fb_map()) {
+		return -1;
+	}
+	fuxi_fb_request = scale ? scale : FUXI_FB_SCALE;
+	wakeup(&fuxi_fb_chan);
+	return 0;
+}
+
 static void
 ud_cmd_dispatch(socket_t so, char *line)
 {
