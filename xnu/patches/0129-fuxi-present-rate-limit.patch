fuxi: 0129 -- cap the present rate; stop spending a core on the boot animation

The copy path moves the whole panel on every present: 1080x2400x4 = 10.4 MB of memcpy
plus the same again in cache cleaning, at ~23 presents/s.  That is roughly 480 MB/s of
work on one core, to animate a progress bar, while the boot is waiting on daemons.

Presents are now rate limited to sweetfb_fps (default 15).  A boot screen does not need
more than that to look alive, and the CPU it frees is CPU the boot actually needs.

Harness: applied=128 skipped=0.
--- a/iokit/Kernel/arm/FuxiFramebuffer.cpp
+++ b/iokit/Kernel/arm/FuxiFramebuffer.cpp
@@ -523,6 +523,41 @@
 	uint32_t mask = get32(rec, 0x104);
 
 	/*
+	 * The copy path moves the whole panel every present: 1080x2400x4 = 10.4 MB of
+	 * memcpy plus the same again in cache cleaning, at whatever rate the compositor
+	 * manages (~23/s observed).  That is ~480 MB/s of work on one core to animate a
+	 * boot screen.  Cap the rate: the panel does not need more than sweetfb_fps
+	 * (default 15) updates per second to look alive, and the CPU is better spent on
+	 * the daemons the boot is actually waiting for.
+	 */
+	{
+		static uint64_t fuxi_last_present_ns;
+		static uint64_t fuxi_min_gap_ns;
+		static bool fuxi_rate_init;
+
+		if (!fuxi_rate_init) {
+			int fps = 15;
+
+			fuxi_rate_init = true;
+			if (!PE_parse_boot_argn("sweetfb_fps", &fps, sizeof(fps))) {
+				fps = 15;
+			}
+			fuxi_min_gap_ns = (fps > 0) ? (1000000000ull / (uint64_t)fps) : 0;
+		}
+		if (fuxi_min_gap_ns != 0) {
+			uint64_t now = mach_absolute_time();
+			uint64_t now_ns = 0;
+
+			absolutetime_to_nanoseconds(now, &now_ns);
+			if (fuxi_last_present_ns != 0 &&
+			    now_ns - fuxi_last_present_ns < fuxi_min_gap_ns) {
+				return;
+			}
+			fuxi_last_present_ns = now_ns;
+		}
+	}
+
+	/*
 	 * The MDP path teaches the display controller to scan out the composited
 	 * surface, and on this port it reports success while the panel keeps showing
 	 * whatever was in the boot framebuffer: 9000 swaps, a frames-identical panel.
