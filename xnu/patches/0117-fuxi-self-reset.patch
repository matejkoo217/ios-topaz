 #define FUXI_PSCI_SYSTEM_RESET  0x84000009ULL
 
+/*
+ * Self-healing without hands on the device.
+ *
+ * Two failures have cost this port hours: the host goes away (or USB never comes
+ * up) and the phone sits there, and a panic halts it where only a human can reach
+ * it.  Both now end in a reset the SoC performs itself.
+ *
+ *  - A supervisor thread resets over PSCI when no host command has arrived for
+ *    sweetdeadman seconds (default 600, 0 disables).  A conversation keeps it
+ *    alive; silence ends it, so a stale boot cannot outlive the session watching
+ *    it.
+ *  - panic() itself resets, after the ring flush, so a crashed phone comes back to
+ *    something the host can reach instead of a frozen screen.  sweetpanicreset=0
+ *    keeps the old halt-on-panic behaviour for a debugging session.
+ *
+ * Neither survives a kernel that stops executing entirely -- that needs a hardware
+ * watchdog armed below XNU, and this board's watchdog base is not in the ADT.
+ */
+#define FUXI_DEADMAN_DEFAULT_S  600u
+#define FUXI_DEADMAN_CHECK_MS   15000u
+
+static volatile uint64_t fuxi_cmd_last_ns;      /* 0 = no host command yet */
+static uint32_t fuxi_deadman_s;
+
+static uint64_t
+fuxi_now_ns(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+/* Called wherever a host command arrives (ethertype and UDP channels). */
+static void
+fuxi_cmd_touch(void)
+{
+	fuxi_cmd_last_ns = fuxi_now_ns();
+}
+
+static void
+fuxi_deadman_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t boot_ns = fuxi_now_ns();
+
+	for (;;) {
+		uint64_t now, last, idle_s;
+
+		ud_sleep_ms(FUXI_DEADMAN_CHECK_MS);
+		if (fuxi_deadman_s == 0) {
+			continue;
+		}
+		now = fuxi_now_ns();
+		last = fuxi_cmd_last_ns;
+		if (last == 0 || last < boot_ns) {
+			last = boot_ns;
+		}
+		idle_s = (now - last) / 1000000000ULL;
+		if (idle_s >= fuxi_deadman_s) {
+			printf("FUXI DEADMAN: %llu s without a host command, resetting\n",
+			    idle_s);
+			ud_sleep_ms(200);       /* let the line leave first */
+			fuxi_soc_reset();
+		}
+	}
+}
+
+void
+fuxi_deadman_start(void)
+{
+	thread_t thread;
+	uint32_t arg = FUXI_DEADMAN_DEFAULT_S;
+
+	if (!PE_parse_boot_argn("sweetdeadman", &arg, sizeof(arg))) {
+		arg = FUXI_DEADMAN_DEFAULT_S;
+	}
+	fuxi_deadman_s = arg;
+	if (fuxi_deadman_s == 0) {
+		printf("FUXI DEADMAN: disabled\n");
+		return;
+	}
+	if (kernel_thread_start(fuxi_deadman_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("FUXI DEADMAN: %u s without a host command resets the SoC\n",
+		    fuxi_deadman_s);
+	}
+}
+
+/* Called from panic() after the ring flush: a crashed phone reboots itself. */
+void
+fuxi_panic_reset(void)
+{
+	int enabled = 1;
+
+	if (!PE_parse_boot_argn("sweetpanicreset", &enabled, sizeof(enabled))) {
+		enabled = 1;
+	}
+	if (!enabled) {
+		return;
+	}
+	printf("FUXI PANIC: resetting the SoC\\n");
+	fuxi_soc_reset();               /* SMC; does not return */
+}
+
