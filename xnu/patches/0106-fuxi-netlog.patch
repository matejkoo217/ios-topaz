+bool
+fuxi_usb_net_ready(void)
+{
+	return ud.ifp != NULL && ud.configured;
+}
+
+/*
+ * Send one netlog frame: a real Ethernet frame with FUXI_NETLOG_ETHERTYPE, so
+ * it goes through exactly the same TX queue, DMA buffer and completion path as
+ * any other traffic on ue0 (ud_if_output frees the mbuf).
+ */
+int
+fuxi_usb_net_send(const void *payload, size_t len)
+{
+	struct ether_header *eh;
+	mbuf_t m = NULL;
+
+	if (!fuxi_usb_net_ready() || len == 0 || len > FUXI_NETLOG_FRAME_MAX) {
+		return ENXIO;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		return ENOMEM;
+	}
+	if (mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		mbuf_freem(m);
+		return ENOMEM;
+	}
+	eh = (struct ether_header *)mbuf_data(m);
+	memcpy(eh->ether_dhost, ud_host_mac, ETHER_ADDR_LEN);
+	memcpy(eh->ether_shost, ud_phone_mac, ETHER_ADDR_LEN);
+	eh->ether_type = htons(FUXI_NETLOG_ETHERTYPE);
+	memcpy((char *)mbuf_data(m) + ETHER_HDR_LEN, payload, len);
+	mbuf_setlen(m, ETHER_HDR_LEN + len);
+	mbuf_pkthdr_setlen(m, ETHER_HDR_LEN + len);
+	return ud_if_output(ud.ifp, m);
+}
