--- a/bsd/dev/fuxi_netlog.c
+++ b/bsd/dev/fuxi_netlog.c
@@ -0,0 +1,226 @@
+/*
+ * FUXI netlog: the kernel's console and a command channel over the USB link.
+ *
+ * With sweethw=1 the phone enumerates as a CDC-ECM Ethernet device
+ * (bsd/dev/fuxi_usb.c) and the host's cdc_ether owns the bulk pipe.  Rather than
+ * build an IP story for that (no DHCP, no in-kernel UDP server), this rides its
+ * own ethertype, 0x88B5 ("local experimental"), through the same interface: the
+ * host reads those frames with an AF_PACKET socket and needs no interface
+ * configuration at all.
+ *
+ * Phone -> host: the console stream.  Every character kernel printf() emits
+ * passes through conslog_putc(), which taps it into a lock-free ring; a kernel
+ * thread drains that ring into frames of at most FUXI_NETLOG_FRAME bytes.  So
+ * "stream logs" means the same text the framebuffer gets -- including a panic,
+ * which is exactly when the screen is useless -- at the cost of one byte copy.
+ *
+ * Host -> phone: one text command per frame.  Deliberately small, and read-only
+ * apart from the log switch:
+ *
+ *   help                this list
+ *   stat                bytes streamed, frames, drops, uptime
+ *   cpu                 current core and measured clock (PMCCNTR, patch 0105)
+ *   log on|off          start/stop streaming the console
+ *   echo <text>         round-trip test
+ *
+ * The tap is lock-free on purpose: printf holds the OS-log lock and runs in
+ * interrupt context and in a panic, so the producer only writes a byte and
+ * bumps a release counter, and the drain thread is the sole consumer.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/mbuf.h>
+#include <sys/kernel.h>
+#include <sys/proc.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+#define FUXI_NETLOG_SIZE   65536u       /* ring size, power of two */
+#define FUXI_NETLOG_FRAME  1200u        /* payload bytes per USB frame */
+#define FUXI_NETLOG_CHUNK  1024u        /* bytes per drain iteration */
+
+extern int fuxi_usb_net_send(const void *payload, size_t len);
+extern bool fuxi_usb_net_ready(void);
+extern uint32_t fuxi_cpu_khz(void);             /* bsd/dev/fuxi_sample.c */
+extern unsigned int ml_get_cpu_number_local(void);
+int vsnprintf(char *str, size_t size, const char *fmt, va_list ap);
+
+static char fuxi_netlog_ring[FUXI_NETLOG_SIZE];
+static volatile uint32_t fuxi_netlog_head;      /* producer publishes here */
+static volatile uint32_t fuxi_netlog_tail;      /* consumer only */
+static volatile uint32_t fuxi_netlog_dropped;
+static volatile uint64_t fuxi_netlog_bytes;
+static volatile uint64_t fuxi_netlog_frames;
+static bool fuxi_netlog_on;
+
+static uint32_t
+netlog_load(volatile uint32_t *p)
+{
+	return os_atomic_load(p, relaxed);
+}
+
+static uint64_t
+netlog_load64(volatile uint64_t *p)
+{
+	return os_atomic_load(p, relaxed);
+}
+
+/*
+ * Producer: called from conslog_putc() for every console character.  Must not
+ * block, allocate, or take a lock that printf might already hold.
+ */
+void
+fuxi_netlog_putc(char c)
+{
+	uint32_t head, tail;
+
+	if (!fuxi_netlog_on) {
+		return;
+	}
+	head = netlog_load(&fuxi_netlog_head);
+	tail = netlog_load(&fuxi_netlog_tail);
+	if (head - tail >= FUXI_NETLOG_SIZE) {
+		os_atomic_store(&fuxi_netlog_dropped,
+		    netlog_load(&fuxi_netlog_dropped) + 1, relaxed);
+		return;
+	}
+	fuxi_netlog_ring[head & (FUXI_NETLOG_SIZE - 1)] = c;
+	os_atomic_store(&fuxi_netlog_head, head + 1, release);
+}
+
+static void
+netlog_send(const void *buf, size_t len)
+{
+	if (!fuxi_usb_net_ready()) {
+		return;
+	}
+	while (len > 0) {
+		size_t n = MIN(len, (size_t)FUXI_NETLOG_FRAME);
+		if (fuxi_usb_net_send(buf, n) != 0) {
+			return;
+		}
+		os_atomic_store(&fuxi_netlog_frames,
+		    netlog_load64(&fuxi_netlog_frames) + 1, relaxed);
+		buf = (const char *)buf + n;
+		len -= n;
+	}
+}
+
+static void
+netlog_reply(const char *fmt, ...)
+{
+	char buf[256];
+	va_list ap;
+	int n;
+
+	va_start(ap, fmt);
+	n = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (n > 0) {
+		netlog_send(buf, (size_t)MIN(n, (int)sizeof(buf) - 1));
+	}
+}
+
+static void
+netlog_cmd(char *line)
+{
+	size_t len = strlen(line);
+
+	while (len > 0 && (line[len - 1] == '\r' || line[len - 1] == '\n')) {
+		line[--len] = '\0';
+	}
+	if (len == 0) {
+		return;
+	}
+	if (strcmp(line, "help") == 0) {
+		netlog_reply("FUXI netlog: stat | cpu | log on|off | echo <text> | help\n");
+	} else if (strcmp(line, "stat") == 0) {
+		uint64_t up = 0, up_ns = 0;
+		clock_get_uptime(&up);
+		absolutetime_to_nanoseconds(up, &up_ns);
+		netlog_reply("stat: %llu bytes in %llu frames, %u dropped, %u queued, "
+		    "uptime %llu s, stream %s\n",
+		    netlog_load64(&fuxi_netlog_bytes), netlog_load64(&fuxi_netlog_frames),
+		    netlog_load(&fuxi_netlog_dropped),
+		    netlog_load(&fuxi_netlog_head) - netlog_load(&fuxi_netlog_tail),
+		    up_ns / NSEC_PER_SEC, fuxi_netlog_on ? "on" : "off");
+	} else if (strcmp(line, "cpu") == 0) {
+		uint32_t khz = fuxi_cpu_khz();
+		if (khz) {
+			netlog_reply("cpu: cpu%u %u.%03u MHz\n", ml_get_cpu_number_local(),
+			    khz / 1000, khz % 1000);
+		} else {
+			netlog_reply("cpu: cpu%u clock unreadable (PMCCNTR off)\n",
+			    ml_get_cpu_number_local());
+		}
+	} else if (strcmp(line, "log off") == 0) {
+		fuxi_netlog_on = false;
+		netlog_reply("log: off\n");
+	} else if (strcmp(line, "log on") == 0) {
+		fuxi_netlog_on = true;
+		netlog_reply("log: on\n");
+	} else if (strncmp(line, "echo ", 5) == 0) {
+		netlog_reply("echo: %s\n", line + 5);
+	} else {
+		netlog_reply("?: %s (try help)\n", line);
+	}
+}
+
+/* Called from the USB receive path for frames carrying FUXI_NETLOG_ETHERTYPE. */
+void
+fuxi_netlog_rx(const void *payload, size_t len)
+{
+	char line[256];
+	size_t n = MIN(len, sizeof(line) - 1);
+
+	memcpy(line, payload, n);
+	line[n] = '\0';
+	netlog_cmd(line);
+}
+
+static void
+netlog_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static char chunk[FUXI_NETLOG_CHUNK];
+
+	for (;;) {
+		uint32_t head = netlog_load(&fuxi_netlog_head);
+		uint32_t tail = netlog_load(&fuxi_netlog_tail);
+
+		if (head != tail && fuxi_usb_net_ready()) {
+			uint32_t n = 0;
+			while (tail != head && n < sizeof(chunk)) {
+				chunk[n++] = fuxi_netlog_ring[tail & (FUXI_NETLOG_SIZE - 1)];
+				tail++;
+			}
+			os_atomic_store(&fuxi_netlog_tail, tail, release);
+			os_atomic_store(&fuxi_netlog_bytes,
+			    netlog_load64(&fuxi_netlog_bytes) + n, relaxed);
+			netlog_send(chunk, n);
+			continue;                       /* more may be waiting */
+		}
+		(void)tsleep((caddr_t)&fuxi_netlog_tail, PZERO, "fuxilog", 1);
+	}
+}
+
+void
+fuxi_netlog_start(void)
+{
+	int on = 1;
+	thread_t thread;
+
+	if (fuxi_netlog_on) {
+		return;
+	}
+	if (PE_parse_boot_argn("fuxinet", &on, sizeof(on)) && on == 0) {
+		printf("FUXI netlog: disabled by fuxinet=0\n");
+		return;
+	}
+	fuxi_netlog_on = true;
+	if (kernel_thread_start(netlog_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("FUXI netlog: ethertype 0x88b5 over the USB link, host side "
+		    "tools/fuxi-netlog.py\n");
+	}
+}
