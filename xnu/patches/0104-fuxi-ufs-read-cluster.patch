+/*
+ * Read-ahead window.
+ *
+ * The VFS/HFS+ layer issues ~4 KiB per strategy call, so a 1 MiB bounce buffer
+ * is never filled by a single command: a cold boot of the 3.3 GB dyld share
+ * cache is order 800k separate 4 KiB SCSI reads. A window of RA_DEFAULT_KIB is
+ * fetched by ONE command into the slot's bounce buffer and the following
+ * sequential reads are memcpy'd out of it, so the command count drops by the
+ * window/request ratio (256 KiB / 4 KiB = 64).
+ *
+ * Tunable at boot: ufsra=<KiB>, 0 disables the window entirely (plain per-request
+ * reads, the pre-clustering behaviour), which is what makes an A/B comparison
+ * possible on the same kernel.
+ */
+#define RA_DEFAULT_KIB  256u
+#define RA_MIN_KIB      8u
+#define RA_SMALL_READ   (64u << 10)     /* only requests smaller than this use a window */
