+	int error = ufs_scsi_slot(slot, cdb, sizeof(cdb), count * UFS_BLOCK, true);
+	/*
+	 * A window in ANY slot may now hold a pre-write copy of these blocks, so
+	 * bump write_seq: every slot's window checks it before serving, which
+	 * invalidates them all without walking the array. Bumped on failure too,
+	 * because a failed write may still have landed partially.
+	 */
+	os_atomic_inc_orig(&su.write_seq, relaxed);
+	slot_window_drop(slot);
+	return error;
 }
 
