 /*
+ * Read-ahead window, per slot.
+ *
+ * A window is trusted only when it fully covers the requested blocks and no
+ * write or cache flush has completed since it was filled (su.write_seq). A
+ * stale window handed back as data would corrupt the root filesystem, so
+ * everything here is checked rather than assumed: full containment, a matching
+ * write sequence, and partition bounds on every fill.
+ */
+static bool
+slot_window_has(struct ufs_slot *slot, uint64_t lba, uint32_t nblocks)
+{
+	return slot->win_blocks != 0 &&
+	    slot->win_seq == os_atomic_load(&su.write_seq, relaxed) &&
+	    nblocks <= slot->win_blocks &&
+	    lba >= slot->win_lba &&
+	    lba - slot->win_lba <= slot->win_blocks - nblocks;
+}
+
+static void
+slot_window_drop(struct ufs_slot *slot)
+{
+	slot->win_blocks = 0;
+}
+
+/*
+ * Bring blocks [lba, lba + nblocks) into the slot's bounce buffer as part of an
+ * aligned window. Returns 0 and the byte offset of the first requested block,
+ * ENOENT when no window can serve this request (caller falls back to a plain
+ * read), or an errno from the command.
+ *
+ * The start is aligned to the window size in device-block space and then
+ * CLAMPED to the partition, and the length is clamped to the partition end as
+ * well, so a window can never name a block outside
+ * su.first_block .. su.first_block + su.nblocks - 1. A request that the clamped
+ * window cannot fully contain is refused (ENOENT) rather than partly served.
+ */
+static int
+slot_window_fill(struct ufs_slot *slot, uint64_t lba, uint32_t nblocks, uint32_t *off)
+{
+	uint64_t base = su.first_block;
+	uint64_t end = su.first_block + su.nblocks;     /* exclusive */
+	uint64_t start, blocks;
+	int error;
+
+	if (su.ra_blocks == 0 || nblocks > su.ra_blocks) {
+		return ENOENT;
+	}
+	/* The caller checked the partition, but a window must never rely on that. */
+	if (lba < base || lba + nblocks > end) {
+		return ENOENT;
+	}
+	start = lba - (lba % su.ra_blocks);
+	if (start < base) {
+		start = base;
+	}
+	blocks = MIN((uint64_t)su.ra_blocks, end - start);
+	/*
+	 * Containment, not just size: clamping the start up to the partition base
+	 * (or the length down at the partition end) can leave a window that has
+	 * nblocks blocks but still ends before the request does.  Serving that
+	 * would hand back the wrong blocks, so refuse and let the caller read
+	 * plainly.
+	 */
+	if (lba < start || lba + nblocks > start + blocks) {
+		return ENOENT;
+	}
+	error = ufs_read_blocks_slot(slot, start, (uint32_t)blocks);
+	if (error) {
+		slot_window_drop(slot);
+		return error;
+	}
+	slot->win_lba = start;
+	slot->win_blocks = (uint32_t)blocks;
+	slot->win_seq = os_atomic_load(&su.write_seq, relaxed);
+	*off = (uint32_t)((lba - start) * UFS_BLOCK);
+	return 0;
+}
+
+/*
+ * Read partition blocks [lba, lba + nblocks) and return a pointer to them, plus
+ * an implicit "valid until the slot's next command". Small reads are served
+ * from (or bring in) the slot's window; everything else uses the bounce buffer
+ * directly, exactly as before this change.
+ */
+static int
+ufs_read_blocks_clustered(struct ufs_slot *slot, uint64_t lba, uint32_t nblocks,
+    const void **buf, bool small)
+{
+	uint32_t off = 0;
+	int error;
+
+	if (small && slot_window_has(slot, lba, nblocks)) {
+		*buf = (const char *)slot_bounce(slot) + (lba - slot->win_lba) * UFS_BLOCK;
+		return 0;
+	}
+	if (small) {
+		error = slot_window_fill(slot, lba, nblocks, &off);
+		if (error == 0) {
+			*buf = (const char *)slot_bounce(slot) + off;
+			return 0;
+		}
+		if (error != ENOENT) {
+			return error;
+		}
+	}
+	error = ufs_read_blocks_slot(slot, lba, nblocks);
+	if (error) {
+		return error;
+	}
+	*buf = slot_bounce(slot);
+	return 0;
+}
+
+/*
  * topaz: on 2026-10-19 the LUN0 GPT was found destroyed after iOS sessions.
  * Remember both GPT copies and fence them off; a watchdog thread re-reads
  * them and panics the moment they change.
@@ -407,7 +558,16 @@
