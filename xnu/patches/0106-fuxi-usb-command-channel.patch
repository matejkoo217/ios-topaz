 	NULL, "ios-fuxi", "Fuxi iOS (USB Ethernet)", "0001", "02005E77EE01",
 };
 static const uint8_t ud_phone_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+static const uint8_t ud_host_mac[ETHER_ADDR_LEN]  = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x01 };
+
+/*
+ * Command channel.  The console already streams to the host as UDP :5140
+ * (ud_log_thread below); this adds the missing direction.  It rides its own
+ * ethertype rather than a UDP socket so the receive path is the USB endpoint
+ * itself -- no in-kernel UDP server, no deprecated socket KPI -- and it works
+ * the moment the link enumerates, before IP or ARP exist.
+ *
+ *   help | stat | cpu | echo <text>
+ *
+ * Nothing here prints: reply bytes go out as frames, and a printf would feed the
+ * log stream back into itself.
+ */
+#define FUXI_CMD_ETHERTYPE      0x88b5
+#define FUXI_CMD_FRAME_MAX      (ETHER_MAX_LEN - ETHER_HDR_LEN - ETHER_CRC_LEN)
+
+static errno_t ud_if_output(ifnet_t ifp, mbuf_t m);
+extern uint32_t fuxi_cpu_khz(void);                     /* fuxi_sample.c */
+extern unsigned int ml_get_cpu_number_local(void);      /* osfmk/arm */
+
+static void
+ud_cmd_send(const char *buf, size_t len)
+{
+	struct ether_header *eh;
+	mbuf_t m = NULL;
+
+	if (ud.ifp == NULL || !ud.configured || len == 0 || len > FUXI_CMD_FRAME_MAX) {
+		return;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		return;
+	}
+	if (mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		mbuf_freem(m);
+		return;
+	}
+	eh = (struct ether_header *)mbuf_data(m);
+	memcpy(eh->ether_dhost, ud_host_mac, ETHER_ADDR_LEN);
+	memcpy(eh->ether_shost, ud_phone_mac, ETHER_ADDR_LEN);
+	eh->ether_type = htons(FUXI_CMD_ETHERTYPE);
+	memcpy((char *)mbuf_data(m) + ETHER_HDR_LEN, buf, len);
+	mbuf_setlen(m, ETHER_HDR_LEN + len);
+	mbuf_pkthdr_setlen(m, ETHER_HDR_LEN + len);
+	(void)ud_if_output(ud.ifp, m);
+}
+
+static void
+ud_cmd(const char *line)
+{
+	char reply[192];
+	size_t len = strlen(line);
+	int n;
+
+	while (len > 0 && (line[len - 1] == '\r' || line[len - 1] == '\n')) {
+		len--;
+	}
+	if (len == 0) {
+		return;
+	}
+	if (len == 4 && strncmp(line, "help", 4) == 0) {
+		n = snprintf(reply, sizeof(reply),
+		    "fuxi: stat | cpu | echo <text> | help  (console: udp 5140)\n");
+	} else if (len == 4 && strncmp(line, "stat", 4) == 0) {
+		n = snprintf(reply, sizeof(reply),
+		    "usb: ue0 %s, rx %llu tx %llu frames, %llu events\n",
+		    ud.configured ? "up" : "down", ud.rx_frames, ud.tx_frames, ud.events);
+	} else if (len == 3 && strncmp(line, "cpu", 3) == 0) {
+		uint32_t khz = fuxi_cpu_khz();
+		if (khz) {
+			n = snprintf(reply, sizeof(reply), "cpu: cpu%u %u.%03u MHz\n",
+			    ml_get_cpu_number_local(), khz / 1000, khz % 1000);
+		} else {
+			n = snprintf(reply, sizeof(reply),
+			    "cpu: cpu%u clock unreadable (PMCCNTR off)\n",
+			    ml_get_cpu_number_local());
+		}
+	} else if (len > 5 && strncmp(line, "echo ", 5) == 0) {
+		int m = snprintf(reply, sizeof(reply), "echo: %.*s\n", (int)(len - 5), line + 5);
+		n = m;
+	} else {
+		n = snprintf(reply, sizeof(reply), "?: %.*s (try help)\n", (int)len, line);
+	}
+	if (n > 0) {
+		ud_cmd_send(reply, (size_t)MIN(n, (int)sizeof(reply) - 1));
+	}
+}
 
