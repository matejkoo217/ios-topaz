+/*
+ * Command listener: the direction the link was missing.
+ *
+ * The console already streams one way (ud_log_thread, UDP 5140).  This is the
+ * other way, on UDP 5141, so a host can ask the phone things and tell it to
+ * restart without a keyboard, a fastboot cable trip, or any host-side privilege
+ * (the caller is plain UDP, not AF_PACKET).
+ *
+ *   help | stat | cpu | echo <text> | restart
+ *
+ * Bound to INADDR_ANY on purpose: the address arrives via SIOCAIFADDR, and the
+ * listener has to survive being up before that happens.  Once the link is
+ * enumerated there is exactly one sender -- the host -- so no filtering beyond
+ * the port is needed.
+ */
+#define FUXI_CMD_PORT   5141u
+
+static void
+ud_cmd_reply(socket_t so, struct sockaddr_in *to, const char *text)
+{
+	struct iovec iov = { .iov_base = (void *)text, .iov_len = strlen(text) };
+	struct msghdr msg = {
+		.msg_name = to, .msg_namelen = (socklen_t)sizeof(*to),
+		.msg_iov = &iov, .msg_iovlen = 1,
+	};
+	size_t sent = 0;
+
+	(void)sock_send(so, &msg, 0, &sent);
+}
+
+static void
+ud_cmd_dispatch(socket_t so, struct sockaddr_in *from, char *line)
+{
+	char reply[160];
+	size_t len = strlen(line);
+	int n;
+
+	while (len > 0 && (line[len - 1] == '\r' || line[len - 1] == '\n')) {
+		line[--len] = '\0';
+	}
+	if (len == 0) {
+		return;
+	}
+	if (strncmp(line, "restart", 7) == 0) {
+		/*
+		 * Out of the kernel, not through userspace: the bring-up escape
+		 * hatch.  It resets to whatever the boot partition holds (Android),
+		 * where the host can 'adb reboot bootloader' again.
+		 */
+		ud_cmd_reply(so, from, "restart: resetting\n");
+		printf("FUXI CMD: restart requested over usb\n");
+		ud_sleep_ms(50);                /* let the datagram leave first */
+		PEHaltRestart(kPERestartCPU);
+		return;
+	}
+	if (strncmp(line, "help", 4) == 0) {
+		n = snprintf(reply, sizeof(reply),
+		    "fuxi: stat | cpu | echo <text> | restart | help\n");
+	} else if (strncmp(line, "stat", 4) == 0) {
+		n = snprintf(reply, sizeof(reply),
+		    "usb: ue0 %s, rx %llu tx %llu frames, %llu events\n",
+		    ud.configured ? "up" : "down", ud.rx_frames, ud.tx_frames, ud.events);
+	} else if (strncmp(line, "cpu", 3) == 0) {
+		uint32_t khz = fuxi_cpu_khz();
+		n = khz ? snprintf(reply, sizeof(reply), "cpu: cpu%u %u.%03u MHz\n",
+		    ml_get_cpu_number_local(), khz / 1000, khz % 1000) :
+		    snprintf(reply, sizeof(reply), "cpu: cpu%u clock unreadable\n",
+		    ml_get_cpu_number_local());
+	} else if (strncmp(line, "echo ", 5) == 0) {
+		n = snprintf(reply, sizeof(reply), "echo: %s\n", line + 5);
+	} else {
+		n = snprintf(reply, sizeof(reply), "?: %s (try help)\n", line);
+	}
+	if (n > 0) {
+		ud_cmd_reply(so, from, reply);
+	}
+}
+
+static void
+ud_cmd_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t so = NULL;
+	struct sockaddr_in me;
+
+	bzero(&me, sizeof(me));
+	me.sin_len = sizeof(me);
+	me.sin_family = AF_INET;
+	me.sin_port = htons(FUXI_CMD_PORT);
+	me.sin_addr.s_addr = htonl(INADDR_ANY);
+
+	for (;;) {
+		struct msghdr msg;
+		struct sockaddr_in from;
+		char line[192];
+		mbuf_t m = NULL;
+		size_t len = sizeof(line) - 1;
+
+		if (so == NULL) {
+			if (sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+				so = NULL;
+				ud_sleep_ms(500);
+				continue;
+			}
+			if (sock_bind(so, (struct sockaddr *)&me) != 0) {
+				sock_close(so);
+				so = NULL;
+				ud_sleep_ms(500);
+				continue;
+			}
+		}
+		bzero(&msg, sizeof(msg));
+		bzero(&from, sizeof(from));
+		msg.msg_name = &from;
+		msg.msg_namelen = (socklen_t)sizeof(from);
+		if (sock_receivembuf(so, &msg, 0, &m, &len) != 0 || m == NULL) {
+			if (m != NULL) {
+				mbuf_freem(m);
+			}
+			ud_sleep_ms(100);
+			continue;
+		}
+		if (len > sizeof(line) - 1) {
+			len = sizeof(line) - 1;
+		}
+		mbuf_copydata(m, 0, len, line);
+		mbuf_freem(m);
+		line[len] = '\0';
+		ud_cmd_dispatch(so, &from, line);
+	}
+}
+
 static void
 ud_thread(void *arg __unused, wait_result_t wr __unused)
 {
@@ -895,6 +1030,17 @@
  * so the boot is included. Nothing here may print (it would feed itself).
  * Boot-arg sweetusblog=0 disables it.
  */
+static void
+ud_cmd_start(void)
+{
+	thread_t thread;
+
+	if (kernel_thread_start(ud_cmd_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("FUXI USB: command channel on udp %u\n", FUXI_CMD_PORT);
+	}
+}
+
