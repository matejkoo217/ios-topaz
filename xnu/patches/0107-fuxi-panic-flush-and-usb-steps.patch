 #define FUXI_LOG_BLOCKS        (1 + FUXI_LOG_SIZE / UFS_BLOCK)
 #define FUXI_LOG_SECS          10u
 
+#define FUXI_LOG_PANIC_BYTES    (4 * UFS_BLOCK)  /* 16 KiB is ~200 console lines */
+
 static char fuxi_log_ring[FUXI_LOG_SIZE];
+static struct ufs_slot *fuxi_log_panic_slot;
 static uint64_t _Atomic fuxi_log_total;
 static int fuxi_log_chan;
 static uint32_t fuxi_log_secs = FUXI_LOG_SECS;
@@ -1142,6 +1145,58 @@
 	uint64_t total, seq;
 };
 
+/*
+ * Flush the ring from the panic path.  A panic halts every other CPU and every
+ * other thread, so the 10 s log thread never runs again and the ring on
+ * userdata keeps whatever the *previous* boot left -- which is why an early
+ * panic currently leaves no trace at all.  This writes the tail synchronously
+ * with a slot reserved for it, and marks the header seq 0xffffffff so a reader
+ * can tell a panic flush from a periodic one.  Best effort: if the controller is
+ * wedged, the panic is lost anyway.
+ */
+void fuxi_log_flush_panic(void);
+
+void
+fuxi_log_flush_panic(void)
+{
+	static bool already;
+	uint64_t total, base, off, start;
+	uint32_t blk, n;
+	struct fuxi_log_header h;
+
+	if (already || !su.ready || !su.writable || fuxi_log_panic_slot == NULL) {
+		return;
+	}
+	already = true;
+	total = os_atomic_load(&fuxi_log_total, relaxed);
+	if (total == 0) {
+		return;
+	}
+	base = su.first_block + su.nblocks - FUXI_LOG_BLOCKS;
+	start = total > FUXI_LOG_PANIC_BYTES ? total - FUXI_LOG_PANIC_BYTES : 0;
+	off = start % FUXI_LOG_SIZE;
+	blk = (uint32_t)(off / UFS_BLOCK);
+	n = (uint32_t)MIN((uint64_t)(FUXI_LOG_PANIC_BYTES / UFS_BLOCK),
+	    (uint64_t)(FUXI_LOG_SIZE / UFS_BLOCK - blk));
+	memcpy(slot_bounce(fuxi_log_panic_slot),
+	    fuxi_log_ring + (uint64_t)blk * UFS_BLOCK, (size_t)n * UFS_BLOCK);
+	if (ufs_write_blocks_slot(fuxi_log_panic_slot, base + 1 + blk, n) != 0) {
+		return;
+	}
+	h.magic[0] = 'F'; h.magic[1] = 'U'; h.magic[2] = 'X'; h.magic[3] = 'I';
+	h.magic[4] = '-'; h.magic[5] = 'L'; h.magic[6] = 'O'; h.magic[7] = 'G';
+	h.version = 1;
+	h.size = FUXI_LOG_SIZE;
+	h.total = total;
+	h.seq = 0xffffffffull;
+	bzero(slot_bounce(fuxi_log_panic_slot), UFS_BLOCK);
+	memcpy(slot_bounce(fuxi_log_panic_slot), &h, sizeof(h));
+	if (ufs_write_blocks_slot(fuxi_log_panic_slot, base, 1) != 0) {
+		return;
+	}
+	(void)ufs_sync_cache_slot(fuxi_log_panic_slot);
+}
+
 static void
 fuxi_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -1213,6 +1268,7 @@
 	if (fuxi_log_secs == 0 || fuxi_log_secs > 60) {
