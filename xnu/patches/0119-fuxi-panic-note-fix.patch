+/*
+ * The console the panic message goes to is not the console the ring sees.  Tee the
+ * characters: formatted output reaches userdata, so a self-reset still leaves the
+ * reason behind.
+ */
+static void
+fuxi_panic_tee_putc(char c)
+{
+	extern void fuxi_log_panic_putc(int);
+
+	consdebug_putc(c);
+	fuxi_log_panic_putc((int)c);
+}
