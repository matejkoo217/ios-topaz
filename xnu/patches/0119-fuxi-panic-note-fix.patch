fuxi: 0119 -- tee the panic output into the ring instead of guessing at buffers

Two attempts failed for the same reason: neither `str` nor `panic_format_str` is in
scope where the hook lives (it is debugger_collect_diagnostics), and debug_buf_base
does not hold the formatted text at that point.  The message is emitted by
_doprnt(debugger_panic_str, debugger_panic_args, consdebug_putc, 0) -- so tee the
output: fuxi_panic_tee_putc writes each character to the console and to the ring.

The ring now receives the panic text exactly as printed, formatted, with no
assumptions about which buffer holds what. Both _doprnt call sites use the tee, and
the sanitised note stays as a fallback.

Also fixes the off-by-prefix in the note (text at line[12+n] under a 17-byte label).

Harness: applied=118 skipped=0.
--- a/bsd/dev/fuxi_ufs.c
+++ b/bsd/dev/fuxi_ufs.c
@@ -1168,16 +1168,40 @@
 void
 fuxi_log_panic_note(const char *text)
 {
-	char line[512];
-	int n;
+	char line[520];
+	size_t i, n = 0;
 
-	if (text == NULL || text[0] < ' ' || text[0] > '~') {
+	if (text == NULL) {
 		return;
 	}
-	n = snprintf(line, sizeof(line), "\n*** FUXI PANIC: %.400s\n", text);
-	if (n > 0) {
-		fuxi_log_append(line, n < (int)sizeof(line) ? n : (int)sizeof(line) - 1);
+	/* Sanitise: panic buffers can start with a header or hold raw bytes. */
+	for (i = 0; i < 480 && text[i] != '\0'; i++) {
+		char c = text[i];
+		line[17 + n] = (c >= ' ' && c <= '~') || c == '\n' ? c : '.';
+		n++;
 	}
+	if (n == 0) {
+		return;
+	}
+	memcpy(line, "\n*** FUXI PANIC: ", 17);
+	fuxi_log_append(line, (int)(17 + n));
+	if (line[17 + n - 1] != '\n') {
+		fuxi_log_append("\n", 1);
+	}
+}
+
+/*
+ * Feed the panicking console straight into the ring, one character at a time.
+ * debug.c tees the formatted panic message through this, so the cause lands in the
+ * 16 KiB that survives the reset -- text, not a format string, not a guess at which
+ * buffer holds it.
+ */
+void
+fuxi_log_panic_putc(int c)
+{
+	char ch = (char)c;
+
+	fuxi_log_append(&ch, 1);
 }
 
