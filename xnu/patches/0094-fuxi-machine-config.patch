diff --git a/pexpert/pexpert/arm64/FUXI.h b/pexpert/pexpert/arm64/FUXI.h
new file mode 100644
index 0000000..a589227
--- /dev/null
+++ b/pexpert/pexpert/arm64/FUXI.h
@@ -0,0 +1,124 @@
+/*
+ * Board config for the Xiaomi 13 ("fuxi", Qualcomm SM8550 / Snapdragon 8 Gen 2,
+ * "kalama"): 8 cores - 1x Cortex-X3 + 2x Cortex-A715 + 2x Cortex-A710 +
+ * 3x Cortex-A510 - ARMv9-A with LSE atomics, RCpc and PAN.
+ *
+ * Same family as SWEET/BCM2837 (generic ARM: none of Apple's
+ * implementation-defined system registers), 16K pages and GICv3. Unlike the
+ * Apple SoCs the GIC has two security states (GICD_TYPER SecurityExtn=1):
+ * Group 0 belongs to TrustZone, so every interrupt, including the timer, is a
+ * Group 1 IRQ taken through sleh_irq().
+ *
+ * Differences from sweet (SM7150) that matter here:
+ *   - ARMv9: LSE, RCpc and PAN are present, so there is no -mcpu=cortex-a53 and
+ *     no userland LSE/LDAPR emulation (those exist only for topaz's ARMv8.0
+ *     Kryo 260). __ARM_PAN_AVAILABLE__ stays on.
+ *   - All 8 cores can run XNU (every core has the 16K granule): no
+ *     "park the Silver cores, boot on Gold only" hand-off.
+ *   - GICv3 + ITS at 0x17140000; redistributor stride is 0x40000 (256 KiB),
+ *     not sweet's 0x20000.
+ *   - The architected-timer PPIs follow the standard 13/14/11/10 numbering
+ *     (GIC_PPI in the vendor DT), so the non-secure view of CNTV is INTID 27,
+ *     not sweet's Qualcomm-specific 19.
+ */
+
+#ifndef _PEXPERT_ARM64_FUXI_H
+#define _PEXPERT_ARM64_FUXI_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+/*
+ * fuxi inherits the sweet (SM7150) bring-up: the Qualcomm driver stack added
+ * by the 0003-0093 patch series (sweet_ufs, AppleKeyStore, IOSurface/IOMFB,
+ * IOWatchdog, SweetPlatformExpert/CPU, AMFI, ...) is gated on the sweet board
+ * macros. Keep both defined so those drivers build into the FUXI kernel.
+ *
+ *   FUXI  - the SM8550 board; new/retargeted code should gate on this.
+ *   SWEET - the inherited bring-up family (kept for the existing drivers).
+ *           MACHINE_FLAGS_ARM64_FUXI also passes -DARM64_BOARD_CONFIG_SWEET.
+ *
+ * TODO fuxi: split the SoC-independent bring-up out of the SWEET guards, then
+ * gate the SM7150-specific bits (SPMI/GENI SE7/GT9896 addresses, RPMh, the
+ * gauge, ...) on `SWEET && !FUXI` and the SM8550 bits on FUXI. Until then,
+ * code under `#if defined(SWEET)` (e.g. patch 0081's userland LSE emulation)
+ * also compiles into the FUXI kernel; see MACHINE_CONFIG_FUXI.md.
+ */
+#define FUXI                      1
+#define SWEET                     1
+
+#define ARM_ARCH_TIMER
+/* TODO fuxi: SM8550 is ARMv9-A; this is XNU's internal version macro and is
+ * left at sweet's value until the arm64 arch-version plumbing is reviewed. */
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+/* fuxi: Cortex-X3/A715/A710/A510 are ARMv9-A -> PAN is present. (The sweet
+ * port's topaz retarget dropped this only because Kryo 260 is ARMv8.0.) */
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * fuxi's architected timer uses the standard PPI numbering (GIC_PPI 13/14/11/
+ * 10 in the vendor DT), so in the non-secure GIC view the virtual timer XNU
+ * uses (CNTV) is INTID 16 + 11 = 27 and the physical timer is 16 + 14 = 30.
+ * (sweet used Qualcomm's 1/2/3/0 numbering -> 19.)
+ *
+ * The kernel name SWEET_VTIMER_INTID is kept because the inherited sleh_irq()
+ * and the ADT virtual-timer plumbing reference it; FUXI_VTIMER_INTID is the
+ * same value for new code.
+ *
+ * INFERRED: from the fuxi vendor device tree (via the M1 shim retarget).
+ * TODO fuxi: confirm at runtime against the ADT `gic` node's
+ * `virtual-timer-intid` (patch 0017 reads it from the device tree).
+ */
+#define SWEET_VTIMER_INTID        27
+#define FUXI_VTIMER_INTID         27
+
+/* SGI used for cross-CPU signals. TODO fuxi: confirm (kept from sweet). */
+#define SWEET_IPI_SGI             1
+#define FUXI_IPI_SGI              1
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+/* fuxi GICR stride is 256 KiB (8 redistributors, 0x17180000..0x17340000),
+ * not sweet's 128 KiB. VERIFIED: fuxi /proc/device-tree + /proc/iomem. */
+#define GICR_PE_SIZE              0x40000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_FUXI_H */
