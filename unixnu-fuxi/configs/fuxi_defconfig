# Kernel configuration of the fuxi image.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# Stage: first hardware bring-up - storage and console. Options that need inputs
# outside the repositories (owner-root bundles, trust caches, verified-root and
# virtio bundles, the prelinked crypto closure) stay off until those inputs
# exist for this board. sheng's list sets all of them; copying it here fails the
# archive builders, not the kernel.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_BOOT_PROGRESS=y

# Needs the qualified AES/crypto prelink closure (XNU_CRYPTO_BOOTSTRAP=prelinked).
# CONFIG_XNU_NATIVE_AES is not set
# Needs the verified virtio/ram-block bundles.
# CONFIG_XNU_NATIVE_VIRTIO_BLOCK is not set
# CONFIG_XNU_NATIVE_RAM_BLOCK is not set
# Needs the verified-root bundle and an owner-signed trust cache.
# CONFIG_XNU_VERIFIED_ROOT_PROBE is not set
# Needs an owner root: trust cache, boot manifest, data volume policy.
# CONFIG_XNU_OWNER_ROOT_AUDIT is not set
# CONFIG_XNU_OWNER_ROOT_TRUST is not set
# CONFIG_XNU_OWNER_CACHE_MOUNT is not set
# CONFIG_XNU_OWNER_CACHE_STARTUP is not set
# CONFIG_XNU_OWNER_BOOT_MANIFEST is not set
# CONFIG_XNU_OWNER_DATA_MOUNT is not set
# CONFIG_XNU_OWNER_UNION_SYSTEMOS is not set
# Runtime trust cache needs an owner root to validate against.
# CONFIG_XNU_TRUST_CACHE_RUNTIME is not set

# Held back for this run: the GPU needs the SQE/ZAP firmware decision.
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# CONFIG_XNU_NATIVE_ADRENO is not set

CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_EXTRA_LD_ARCHIVES=""
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
